{
  "name": "malirstvi-spejtek",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && tsc -p worker && vite build",
    "preview": "vite preview",
    "preview:cf": "vite build && wrangler dev --port 8787",
    "typecheck": "tsc -b --noEmit && tsc -p worker",
    "db:migrate:local": "wrangler d1 migrations apply spejtek --local",
    "db:migrate": "wrangler d1 migrations apply spejtek --remote",
    "deploy": "npm run build && wrangler d1 migrations apply spejtek --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "framer-motion": "^14.6.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
